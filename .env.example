# Arkiv account private key used to sign entity writes (hex, 0x-prefixed)
ARKIV_PRIVATE_KEY=0xyourprivatekey
# Arkiv JSON-RPC HTTP endpoint
ARKIV_RPC_URL=https://rpc.arkiv.example
# Arkiv WebSocket endpoint (optional; derivable from RPC URL)
ARKIV_WS_URL=wss://ws.arkiv.example
# Arkiv chain id (numeric)
ARKIV_CHAIN_ID=7794095
# Arkiv access key for the RPC endpoint
# optional — leave empty for the public Rabdi endpoint
ARKIV_ACCESS_KEY=
# GitHub personal access / app token with repo access
GITHUB_TOKEN=ghp_yourtoken
# Login of the bot account used for PRs/comments (optional)
GITHUB_BOT_LOGIN=klarity-bot
# Owner of the upstream registry repo
UPSTREAM_OWNER=ethereum
# Name of the upstream registry repo
UPSTREAM_REPO=clear-signing-erc7730-registry
# Secret used to verify GitHub webhook signatures (optional)
GITHUB_WEBHOOK_SECRET=yourwebhooksecret
# Comma-separated list of wallet addresses authorized to write (lowercased internally)
AUTHORIZED_WALLETS=0xabc...,0xdef...
# Polling interval in milliseconds for the upstream registry
POLL_INTERVAL_MS=60000
# Path to the local SQLite database file
DB_PATH=./klarity.db
# HTTP port the server listens on
PORT=3000
