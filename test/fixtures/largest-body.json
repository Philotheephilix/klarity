{
  "intent": "Lend or repay, withdraw collateral",
  "interpolatedIntent": "Buy {#.targetUnits} at maturity for max {#.maxBuyerAssets}",
  "fields": [
    {
      "label": "Loan token",
      "format": "addressName",
      "params": {
        "types": [
          "token"
        ]
      },
      "path": "#.market.loanToken"
    },
    {
      "label": "Maturity",
      "format": "date",
      "params": {
        "encoding": "timestamp"
      },
      "path": "#.market.maturity"
    },
    {
      "path": "#.market.collateralParams.[]",
      "iteration": "bundled",
      "fields": [
        {
          "label": "Collateral token",
          "format": "addressName",
          "params": {
            "types": [
              "token"
            ]
          },
          "path": "token",
          "visible": "always"
        },
        {
          "label": "LLTV",
          "format": "unit",
          "params": {
            "base": "%",
            "decimals": 16
          },
          "path": "lltv",
          "visible": "always"
        },
        {
          "label": "Oracle",
          "format": "addressName",
          "params": {
            "types": [
              "contract"
            ]
          },
          "path": "oracle",
          "visible": "always"
        },
        {
          "label": "Liquidation cursor",
          "format": "raw",
          "path": "liquidationCursor",
          "visible": "never"
        }
      ]
    },
    {
      "path": "#.market.chainId",
      "label": "Chain ID",
      "visible": "never",
      "format": "raw"
    },
    {
      "path": "#.market.midnight",
      "label": "Midnight",
      "visible": "never",
      "format": "raw"
    },
    {
      "path": "#.market.rcfThreshold",
      "label": "RCF threshold",
      "visible": "never",
      "format": "raw"
    },
    {
      "path": "#.market.enterGate",
      "label": "Enter gate",
      "visible": "never",
      "format": "raw"
    },
    {
      "path": "#.market.liquidatorGate",
      "label": "Liquidator gate",
      "visible": "never",
      "format": "raw"
    },
    {
      "path": "#.targetUnits",
      "label": "Target amount",
      "format": "tokenAmount",
      "visible": "always",
      "params": {
        "tokenPath": "#.market.loanToken",
        "threshold": "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "message": "Full debt"
      }
    },
    {
      "path": "#.maxBuyerAssets",
      "label": "Max buyer assets",
      "format": "tokenAmount",
      "params": {
        "tokenPath": "#.market.loanToken"
      },
      "visible": "always"
    },
    {
      "path": "#.reduceOnly",
      "label": "Reduce only",
      "format": "raw",
      "visible": "always"
