# The origin of the Klarity API this explorer reads from (no trailing slash).
# Browser requests are proxied SAME-ORIGIN through Next rewrites (see
# next.config.mjs): the client calls /klarity-api/* and the Next server forwards
# to this origin, so the API does NOT need to send CORS headers. SSR and unit
# tests use this origin directly.
NEXT_PUBLIC_KLARITY_API_BASE=http://localhost:8787

# Optional: override the same-origin proxy path the browser client targets.
# Defaults to /klarity-api (must match the `source` in next.config.mjs rewrites).
# NEXT_PUBLIC_KLARITY_API_PROXY=/klarity-api
